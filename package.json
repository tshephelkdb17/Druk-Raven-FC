    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
